# Local configuration and repository metadata never belong in an image build context.
.env
.env.*
!.env.example
.git
.github
.agents
.claude
.codex

# Tooling caches and build products are host-specific and are rebuilt in images.
.local
.tools
node_modules
**/node_modules
target
**/target
build
**/build
dist
**/dist
.venv
**/.venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.mypy_cache
**/.mypy_cache
.vite
**/.vite
coverage
playwright-report
test-results
*.log
