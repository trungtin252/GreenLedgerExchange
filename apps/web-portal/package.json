    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.1",
    "globals": "16.5.0",
    "jsdom": "28.0.0",
    "prettier": "3.8.2",
    "typescript-eslint": "8.38.0",
